# Copiare in ".env" e sostituire i valori. Il .env non si versiona.
# Genera la chiave con:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sostituire-con-una-stringa-casuale-lunga

DATABASE_URL=postgresql+psycopg://UTENTE@localhost:5432/overseas


UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10
SQL_ECHO=0
